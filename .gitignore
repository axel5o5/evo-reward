**/.DS_Store
__pycache__/
**/__pycache__/
*.pyc

# Dashboard
dashboard/site/node_modules/
dashboard/site/dist/
dashboard/site/public/docs/
dashboard/app/.env
dashboard/app/utils/__pycache__/

# Results (large data files)
results/

# External emevo source clone (separate upstream repo, not part of this project)
emevo_src/

# Orchestrator + Claude runtime state (local only)
.claude-orch-state.json
.claude/scheduled_tasks.lock
.claude/session-prompts/

# Dashboard — local/runtime-only files
dashboard/site/.env.local
dashboard/site/tsconfig.tsbuildinfo
# Live data is fetched at runtime from the gcp-status branch;
# any local copy is only for dev and shouldn't be committed.
dashboard/site/public/gcp-status.json
# Local v3 recorder validation artifacts (regenerated by
# scripts/validate_recorder_v3.py). Real replays come from GCS.
dashboard/site/public/replays/test_*/

# Local run logs
logs/

# Local checkpoints
ckpts/

# SSH credentials pulled from VMs (never commit private keys)
.ssh-from-vm/

# Paper-writing scratch dir (drafts, analysis scripts, downloaded results, notes).
# Local only — final manuscript will live elsewhere (Overleaf / submission repo).
paper/

# Dashboard — auto-generated data indexes.
# Regenerated on every build by `npm run extract` (dashboard/extract_data.py).
# Build now fails hard if extract fails (we removed the `|| true` fallback),
# so gitignoring these keeps PR diffs clean without leaving deploys exposed.
dashboard/site/src/data/config-schema.json
dashboard/site/src/data/deviations.json
dashboard/site/src/data/git-timeline.json
dashboard/site/src/data/module-deps.json
dashboard/site/src/data/obs-layout.json
dashboard/site/src/data/sim-loop-steps.json
.vercel
